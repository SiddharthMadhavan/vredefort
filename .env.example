# Optional raster tile URL (256px tiles). The default works without an API key.
CITYCOLLAPSE_TILE_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
CITYCOLLAPSE_MAP_ATTRIBUTION=© OpenStreetMap contributors · © CARTO
# Existing VITE_MAP_TILE_URL and VITE_CARTO_API_KEY in .env remain supported.

# Local Live Traffic Analyst
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Required for real traffic measurements. Leave empty for a data-unavailable assessment.
TOMTOM_API_KEY=
