# Optional raster tile URL (256px tiles). Configure a provider API key if required.
CITYCOLLAPSE_TILE_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
CITYCOLLAPSE_MAP_ATTRIBUTION=© OpenStreetMap contributors · © CARTO
# Existing VITE_MAP_TILE_URL and VITE_CARTO_API_KEY in .env remain supported.
# Basemap choices can also be changed with Map... in the app.
# Uncomment to override the saved UI choice. Cached-only mode makes no tile requests.
# CITYCOLLAPSE_MAP_OFFLINE=true
# Optional local raster MBTiles file, or XYZ directory with z/x/y.png tiles.
# A local map source always runs offline. Vector MBTiles are not supported.
# CITYCOLLAPSE_MAP_PATH=C:/maps/bengaluru.mbtiles

# Local Live Traffic Analyst
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Required for real traffic measurements. Leave empty for a data-unavailable assessment.
TOMTOM_API_KEY=

# Agent 2 uses the bundled synthetic dataset, clearly labelled as a demo baseline.
# Optional overrides; the same Ollama model is used by default.
# OLLAMA_HISTORY_MODEL=llama3.1:8b
# OLLAMA_NETWORK_MODEL=llama3.1:8b
# OLLAMA_PLANNER_MODEL=llama3.1:8b
# OLLAMA_REVIEW_MODEL=llama3.1:8b
# CITYCOLLAPSE_HISTORY_CSV=C:/path/to/bengaluru_road_traffic_synthetic_hourly.csv
