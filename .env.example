# Optional MapLibre style JSON URL. Overrides the raster basemap below.
VITE_MAP_STYLE_URL=
VITE_CARTO_API_KEY=
# Alternatively, a MapTiler key selects its dark vector style automatically.
VITE_MAPTILER_API_KEY=
# Leave style, tile URL and keys empty to use key-free OpenFreeMap Dark.
# Optional CARTO raster template (requires VITE_CARTO_API_KEY).
VITE_MAP_TILE_URL=
# Optional external vehicle adapter URL. Empty starts the local C++ adapter with Vite.
VITE_BACKEND_URL=
# Optional path to a g++ compiler used by the backend adapter.
CXX=
# Change attribution when changing the tile provider.
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors · © CARTO
